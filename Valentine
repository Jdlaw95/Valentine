<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jy mekeer n Valentine 💖</title>
<style>
body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(to bottom, #ff758c, #ff7eb3);
    overflow: hidden;
    text-align: center;
}

.top {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.top img {
    max-width: 50%;
    max-height: 50%;
    border-radius: 10px;
    animation: bounce 1s infinite alternate;
}

h1 {
    color: white;
    font-size: 2rem;
    margin-bottom: 10px;
}

.bottom {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
}

button {
    padding: 15px 35px;
    font-size: 1.3rem;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: 0.3s ease;
}

#yesBtn {
    background-color: #ff2e63;
    color: white;
}

#noBtn {
    background-color: #333;
    color: white;
}

canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
}

@keyframes bounce {
    from { transform: translateY(0px); }
    to { transform: translateY(-15px); }
}
</style>
</head>
<body>

<div class="top">
    <h1>Jy mekeer n Valentine</h1>
    <img id="mainImage" src="finger.gif.GIF" alt="Finger Pointing">
</div>

<div class="bottom">
    <h2>Do you have one?</h2>
    <div>
        <button id="yesBtn">YES ❤️</button>
        <button id="noBtn">NO 😢</button>
    </div>
</div>

<canvas id="fireworks"></canvas>

<script>
let noClickCount = 0;
const noBtn = document.getElementById("noBtn");
const yesBtn = document.getElementById("yesBtn");
const mainImage = document.getElementById("mainImage");
const topSection = document.querySelector(".top");
const bottomSection = document.querySelector(".bottom");

noBtn.addEventListener("click", function() {
    noClickCount++;
    let shrink = 1 - (noClickCount * 0.2);
    let grow = 1 + (noClickCount * 0.3);

    noBtn.style.transform = "scale(" + shrink + ")";
    yesBtn.style.transform = "scale(" + grow + ")";

    if (noClickCount >= 4) {
        noBtn.style.display = "none";
    }
});

yesBtn.addEventListener("click", function() {
    // Hide buttons
    bottomSection.style.display = "none";

    // Fade main GIF out and swap to reveal image
    mainImage.style.transition = "opacity 1s";
    mainImage.style.opacity = "0";

    setTimeout(() => {
        mainImage.src = "reveal.jpg";
        mainImage.style.opacity = "1";
    }, 1000);

    // Add celebration text
    const message = document.createElement("h1");
    message.innerText = "I had a feeling you were going to say YES 😏❤️";
    message.style.color = "white";
    message.style.marginTop = "20px";
    message.style.opacity = "0";
    message.style.animation = "fadeIn 2s forwards";
    topSection.appendChild(message);

    // Add keyframes dynamically
    const style = document.createElement("style");
    style.innerHTML = `
        @keyframes fadeIn {
            0% { opacity: 0; transform: scale(0.8);}
            100% { opacity: 1; transform: scale(1);}
        }
    `;
    document.head.appendChild(style);

    startFireworks();
});

// FIREWORKS CODE
const canvas = document.getElementById("fireworks");
const ctx = canvas.getContext("2d");
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let particles = [];

function createFirework(x, y) {
    for (let i = 0; i < 50; i++) {
        particles.push({
            x: x,
            y: y,
            radius: 2,
            color: `hsl(${Math.random()*360},100%,60%)`,
            speedX: (Math.random()-0.5)*8,
            speedY: (Math.random()-0.5)*8,
            life: 100
        });
    }
}

function startFireworks() {
    setInterval(() => {
        createFirework(Math.random() * canvas.width, Math.random() * canvas.height/2);
    }, 500);
    animate();
}

function animate() {
    requestAnimationFrame(animate);
    ctx.fillStyle = "rgba(0,0,0,0.2)"; // faded effect
    ctx.fillRect(0,0,canvas.width,canvas.height);

    particles.forEach((p, index) => {
        p.x += p.speedX;
        p.y += p.speedY;
        p.life--;

        ctx.beginPath();
        ctx.arc(p.x,p.y,p.radius,0,Math.PI*2);
        ctx.fillStyle = p.color;
        ctx.fill();

        if (p.life <= 0) {
            particles.splice(index,1);
        }
    });
}
</script>

</body>
</html>
